[Unit]
Description=SevaJobs GitHub Webhook Deployment Listener
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sevajobs
Environment="WEBHOOK_PORT=9000"
# Replace the placeholder below with the actual secret from your .env or GitHub
Environment="GITHUB_WEBHOOK_SECRET=your-secure-webhook-secret"

ExecStart=/usr/bin/python3 /opt/sevajobs/scripts/webhook_listener.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
